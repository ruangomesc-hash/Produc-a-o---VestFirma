# Caminho base na URL quando publicar
VITE_BASE_PATH=/

# API (quadro compartilhado no servidor)
VITE_API_BASE=/api
VITE_API_BOARD_PATH=/board.php
VITE_API_NOTIFY_PATH=/notify
VITE_API_HEALTH_PATH=/health
VITE_WHATSAPP_NOTIFY=true
# Antes de publicar: false | Site no ar: use npm run build:publicar (.env.production)
VITE_REQUIRE_LOGIN=false

# Servidor Node (npm run server)
ADMIN_USER=
ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Administrador
REQUIRE_LOGIN=false
SESSION_DAYS=14
PORT=4199
# Webhook n8n / Make / WhatsApp Business API (envio automático ao grupo)
WHATSAPP_WEBHOOK_URL=

# Shopify — pedidos da loja entram em "Pedido feito" e a etapa volta para a Shopify
# Webhook da loja: https://SEU-DOMINIO/api/shopify/webhook
# Eventos: orders/create, orders/updated, orders/cancelled
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2025-01
